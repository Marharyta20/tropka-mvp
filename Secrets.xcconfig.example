// Copy this file to Secrets.xcconfig and fill in your Mapbox token from mapbox.com/account/access-tokens
MBXAccessToken = YOUR_MAPBOX_PUBLIC_TOKEN_HERE
MGLMapboxAccessToken = YOUR_MAPBOX_PUBLIC_TOKEN_HERE

// PostHog project API key from posthog.com → Settings → Project → Project API key.
// Safe to ship in the app: it is write-only (phc_...).
POSTHOG_API_KEY = YOUR_POSTHOG_PROJECT_API_KEY_HERE
// Host WITHOUT the scheme — "//" starts a comment in .xcconfig files.
// eu.i.posthog.com for the EU cloud, us.i.posthog.com for the US cloud.
POSTHOG_HOST = eu.i.posthog.com
